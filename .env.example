# ============================================================
# APTLY — Environment Variables
# Copy this file to .env (and apps/api/.env) for local development.
# NEVER commit real credentials to version control.
# ============================================================

# ─── Application ─────────────────────────────────────────────
APP_ENV=development
APP_NAME=APTLY
APP_VERSION=0.1.0

# ─── API & Security ──────────────────────────────────────────
API_V1_PREFIX=/api/v1
# JSON array or comma-separated list of allowed CORS origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-for-aptly-local-testing-32-bytes

# ─── Database (Supabase PostgreSQL / SQLite fallback) ────────
# Supabase Transaction Pooler (Recommended for Serverless/FastAPI):
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Supabase Direct Connection:
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Local Mock / Zero-Dependency Fallback:
DATABASE_URL=sqlite+aiosqlite:///./aptly.db

# ─── Supabase Infrastructure ─────────────────────────────────
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-side ONLY (never expose to frontend):
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Public Anon Key (safe for frontend public reads if needed):
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─── Storage Provider ────────────────────────────────────────
# Options: supabase | local | s3 | r2
# Set to 'supabase' to use Supabase Storage (bucket: aptly-media)
STORAGE_PROVIDER=local
STORAGE_BUCKET=aptly-media
# For local provider only:
STORAGE_ENDPOINT=./storage

# ─── LLM Provider ────────────────────────────────────────────
# Options: mock | openai | anthropic | google
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ─── TTS Provider ────────────────────────────────────────────
# Options: mock | elevenlabs | openai
TTS_PROVIDER=mock
TTS_API_KEY=

# ─── Transcription Provider ──────────────────────────────────
# Options: mock | whisper | whisperx | deepgram
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_API_KEY=

# ─── Frontend (Next.js — prefix with NEXT_PUBLIC_ to expose) ─
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=APTLY
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─── Feature Flags ───────────────────────────────────────────
FEATURE_REALTIME_INTERVIEW=true
FEATURE_AUDIO_ANALYSIS=true
FEATURE_VISION_ANALYSIS=false
FEATURE_LLM_EVALUATION=true
