# ============================================================
# APTLY — Environment Variables
# Copy this file to .env and fill in real values locally.
# NEVER commit .env to version control.
# ============================================================

# ─── Application ─────────────────────────────────────────────
APP_ENV=development
APP_NAME=APTLY
APP_VERSION=0.1.0

# ─── API ─────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Security ────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret-key-before-any-deployment

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aptly:aptly_dev_password@localhost:5432/aptly_dev

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Storage Provider ────────────────────────────────────────
# Options: local | s3 | supabase | r2
STORAGE_PROVIDER=local
STORAGE_BUCKET=aptly-media
# For local provider, this is the base directory path
STORAGE_ENDPOINT=./storage
# Leave blank for local provider
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ─── LLM Provider ────────────────────────────────────────────
# Options: mock | openai | anthropic | google
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=

# ─── TTS Provider ────────────────────────────────────────────
# Options: mock | elevenlabs | openai
TTS_PROVIDER=mock
TTS_API_KEY=

# ─── Transcription Provider ──────────────────────────────────
# Options: mock | whisper | whisperx | deepgram
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_API_KEY=

# ─── Frontend (Next.js — prefix with NEXT_PUBLIC_ to expose) ─
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=APTLY

# ─── Postgres (Docker Compose internal) ──────────────────────
POSTGRES_USER=aptly
POSTGRES_PASSWORD=aptly_dev_password
POSTGRES_DB=aptly_dev

# ─── Feature Flags (Phase 0 — all off) ───────────────────────
FEATURE_REALTIME_INTERVIEW=false
FEATURE_AUDIO_ANALYSIS=false
FEATURE_VISION_ANALYSIS=false
FEATURE_LLM_EVALUATION=false
