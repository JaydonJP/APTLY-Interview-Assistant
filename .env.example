# ============================================================
# APTLY — Environment Variables
# Copy this file to .env (and apps/api/.env) for development with remote services.
# NEVER commit real credentials to version control.
# ============================================================

# ─── Application ─────────────────────────────────────────────
APP_ENV=development
APP_NAME=APTLY
APP_VERSION=0.1.0

# ─── API & Security ──────────────────────────────────────────
API_V1_PREFIX=/api/v1
# JSON array or comma-separated list of allowed CORS origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-for-aptly-local-testing-32-bytes

# ─── Database (Supabase PostgreSQL) ─────────────────────────
# Use the Transaction Pooler URI from Supabase Project Settings -> Database.
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ─── Supabase Infrastructure ─────────────────────────────────
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-side ONLY (never expose to frontend):
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Public Anon Key (safe for frontend public reads if needed):
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─── Storage Provider ────────────────────────────────────────
# Runtime media storage is Supabase-only. Unit tests inject local storage.
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=aptly-media
STORAGE_ENDPOINT=

# ─── LLM Provider ────────────────────────────────────────────
# Gemini is used for role analysis, question generation, correctness review,
# grounded follow-ups, and doubt explanations.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Gemini TTS is expressive and keeps the key server-side.
TTS_PROVIDER=gemini
TTS_API_KEY=
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Kore
TTS_TIMEOUT_SECONDS=30

# ─── Transcription Provider ──────────────────────────────────
# Options: mock | whisper | whisperx | deepgram
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_API_KEY=
WHISPERX_MODEL=base.en
WHISPERX_DEVICE=auto
WHISPERX_COMPUTE_TYPE=auto
WHISPERX_LANGUAGE=en

# ─── Frontend (Next.js — prefix with NEXT_PUBLIC_ to expose) ─
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=APTLY
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─── Feature Flags ───────────────────────────────────────────
FEATURE_REALTIME_INTERVIEW=false
FEATURE_AUDIO_ANALYSIS=false
FEATURE_VISION_ANALYSIS=false
FEATURE_LLM_EVALUATION=true
