# Copy to apps/api/.env and replace every Supabase placeholder.
# The API database is remote-only; do not use localhost or SQLite.
APP_ENV=development
SECRET_KEY=dev-secret-key-for-aptly-local-testing-32-bytes
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
REDIS_URL=redis://localhost:6379/0
SUPABASE_URL=https://pkxrhjjmwxrirfknmijw.supabase.co
# REST endpoint; keep SUPABASE_URL above as the project root for Auth/Storage.
SUPABASE_REST_URL=https://pkxrhjjmwxrirfknmijw.supabase.co/rest/v1/
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_JWT_ISSUER=https://pkxrhjjmwxrirfknmijw.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
ALLOW_GUEST_SESSIONS=true
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=aptly-media
STORAGE_ENDPOINT=
LLM_PROVIDER=gemini
# Leave blank to inherit LLM_PROVIDER for interview turns.
INTERVIEW_LLM_PROVIDER=
GEMINI_API_KEY=your_google_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
TTS_PROVIDER=mock
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Kore
TRANSCRIPTION_PROVIDER=mock

# Gemini Live Realtime Engine
FEATURE_GEMINI_LIVE_INTERVIEW=false
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp
GEMINI_LIVE_LANGUAGE_CODE=en-US
GEMINI_LIVE_TOKEN_TTL_SECONDS=600
