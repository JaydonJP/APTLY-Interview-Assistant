# Copy to apps/api/.env for development with remote Supabase services.
APP_ENV=development
SECRET_KEY=dev-secret-key-for-aptly-local-testing-32-bytes
# Supabase Transaction Pooler URI from Project Settings -> Database.
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Optional queue URL; leave blank for the inline demo processing path.
REDIS_URL=
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=aptly-media
STORAGE_ENDPOINT=
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-2.5-flash
TTS_PROVIDER=gemini
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Kore
TTS_TIMEOUT_SECONDS=30
TRANSCRIPTION_PROVIDER=mock
