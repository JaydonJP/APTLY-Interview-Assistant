# Copy to apps/api/.env for local development.
# The credentials match the root docker-compose.yml defaults.
APP_ENV=development
SECRET_KEY=dev-secret-key-for-aptly-local-testing-32-bytes
DATABASE_URL=postgresql+asyncpg://aptly:aptly_dev_password@localhost:5432/aptly_dev
REDIS_URL=redis://localhost:6379/0
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=./storage
LLM_PROVIDER=gemini
# Leave blank to inherit LLM_PROVIDER for interview turns.
INTERVIEW_LLM_PROVIDER=
GEMINI_API_KEY=your_google_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
TTS_PROVIDER=mock
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Kore
TRANSCRIPTION_PROVIDER=mock

# Gemini Live Realtime Engine
FEATURE_GEMINI_LIVE_INTERVIEW=false
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp
GEMINI_LIVE_LANGUAGE_CODE=en-US
GEMINI_LIVE_TOKEN_TTL_SECONDS=600
