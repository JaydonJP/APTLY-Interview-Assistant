{
  "openapi": "3.1.0",
  "info": {
    "title": "APTLY",
    "description": "Evidence-Grounded Multimodal AI Interview Coach \u2014 REST API\n\nPhase 0: Foundation scaffold. See /docs for OpenAPI specification.\nSee docs/api/contracts.md for planned endpoint contracts.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Application liveness probe",
        "description": "Simple health check. No auth required. Used by load balancers.",
        "operationId": "root_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Detailed service health",
        "description": "Checks all downstream dependencies. Includes DB and provider status.",
        "operationId": "v1_health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
